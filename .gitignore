# Secrets
.env
.env.*
!.env.example

# Build-time artifacts (regenerate with scripts/run_ingest.py and build_index.py)
data/raw/
data/chroma/
data/embeddings.jsonl
data/chunks.jsonl
data/chunk_stats.json

# Outputs
outputs/results/
outputs/*.json
outputs/demo.mp4
# ...except the four evidence files the README cites by name (8x ingest_report,
# 6x chunk_eval, 4x retrieval_eval, 1x chunk_eval_embed). Without these a reviewer's
# clone cannot check a single number in the README. All four are regenerated by
# scripts/run_ingest.py and eval/run_eval.py.
!outputs/ingest_report.json
!outputs/retrieval_eval.json
!outputs/chunk_eval.json
!outputs/chunk_eval_embed.json

# Regenerable debug artefacts
outputs/embeddings_dump.txt

# Design mockups these files were built from (Stitch exports)
stitch_fundfacts_ui_design_system/
Docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# UI screenshots (local reference, ~160 KB of PNGs)
ScreensotsofUI/
